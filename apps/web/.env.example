# Same-origin Cloudflare production can leave this blank.
VITE_API_BASE_URL=

# Browser key: restrict by HTTP referrer and only enable required Google Maps APIs.
VITE_GOOGLE_MAPS_API_KEY=YOUR_RESTRICTED_WEB_KEY

# Optional custom Google Cloud Map ID. DEMO_MAP_ID is used when omitted.
VITE_GOOGLE_MAP_ID=
