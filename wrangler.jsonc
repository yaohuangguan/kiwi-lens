{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "kiwi-lens",
	"main": "apps/server/src/worker.mjs",
	"compatibility_date": "2026-08-04",
	"assets": {
		"directory": "apps/web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"kv_namespaces": [
		{
			"binding": "CAMERA_DATA",
			"id": "c874d6e739824c52be53071c85c9e005"
		}
	],
	"d1_databases": [
		{
			"binding": "USER_DB",
			"database_name": "kiwi-lens-users"
		}
	],
	"triggers": {
		"crons": [
			"0 */6 * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}